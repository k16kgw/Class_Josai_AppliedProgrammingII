     ]
    }
   ],
   "source": [
    "# 第5回の101×101格子で得た最良の組\n",
    "theta_grid = (0.0275, 14800.0)\n",
    "mse_grid = mean_squared_error(y_obs, simulate_logistic(theta_grid, t_obs, N0))\n",
    "print(f\"第5回の格子上の最良の組 (r, K) = {theta_grid}: MSE = {mse_grid:.1f} （RMSE = {np.sqrt(mse_grid):.1f} 万人）\")"
   ]
  },
